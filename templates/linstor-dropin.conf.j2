# {{ ansible_managed }}
[Service]
{% for k, v in linstor_dropin_env | dictsort %}
{% if ' ' in v | string %}
Environment="{{ k }}={{ v }}"
{% else %}
Environment={{ k }}={{ v }}
{% endif %}
{% endfor %}
{% if linstor_dropin_restart | length > 0 %}
Restart={{ linstor_dropin_restart }}
RestartSec={{ linstor_restart_sec }}s
{% endif %}
